# Public application URL used in local development.
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Cloud MySQL connection. Fill these values in your untracked .env file.
NUXT_MYSQL_HOST=
NUXT_MYSQL_PORT=3306
NUXT_MYSQL_DATABASE=
NUXT_MYSQL_USER=
NUXT_MYSQL_PASSWORD=
NUXT_MYSQL_SSL=

# Server-only development actor. Fill manually after explicit demo loading.
DEV_ACTOR_ID=

# Optional Redis connection. Provide either NUXT_REDIS_URL or the individual values.
NUXT_REDIS_HOST=
NUXT_REDIS_PORT=6379
NUXT_REDIS_PASSWORD=
NUXT_REDIS_DB=
NUXT_REDIS_URL=
