{
  "name": "tutor-workspace",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "db:migrate": "node database/migrate.mjs",
    "db:init-admin": "node database/init-admin.mjs",
    "db:seed": "node database/seeds/students.mjs",
    "db:seed:contracts": "node database/seeds/contracts.mjs",
    "db:seed:records": "node database/seeds/learning-records.mjs",
    "test:s3:api": "node tests/integration/learning-records.mjs",
    "db:seed:plans": "node database/seeds/study-plans.mjs",
    "test:s4:api": "node tests/integration/study-plans.mjs",
    "db:seed:tasks": "node database/seeds/tasks.mjs",
    "test:s5:api": "node tests/integration/tasks.mjs",
    "db:seed:assignments": "node database/seeds/task-assignments.mjs",
    "db:seed:reading-plan": "node database/seeds/reading-composition-plan.mjs",
    "test:s6:api": "node tests/integration/task-assignments.mjs",
    "test:s8:foundation": "node tests/integration/auth-foundation.mjs",
    "test:s8:auth": "vitest run tests/unit/auth-session.test.ts",
    "test:s2:api": "node tests/integration/contracts.mjs",
    "test:s1:api": "node tests/integration/students.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "ant-design-vue": "^4.2.6",
    "mysql2": "^3.24.3",
    "nuxt": "^4.5.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
